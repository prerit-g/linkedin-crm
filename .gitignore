# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
dist-ssr/
*.local

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.thumbs.db

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
logs
*.log

# Coverage directory used by tools like istanbul
coverage/
.nyc_output

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Optional PWA service worker cache
**/service-worker.js
**/sw.js

# Vite cache
.vite/

# Vitest cache
.vitest/

# Windows
[Dd]esktop.ini

# MacOS
.DS_Store

# Linux/Unix
*~

# Temporary files
*.tmp
*.temp

# IDE specific
.vscode/launch.json
.vscode/tasks.json
.vscode/settings.json
*.code-workspace

# Kiro specific (if you want to exclude agent files)
.kiro/artifacts/
.kiro/cache/
.kiro/logs/

# Development builds
build/
.out/

# Production builds (already covered by dist/, but being explicit)
public/build/
public/assets/*.map

# Cache directories
.cache/

# Dependency directories (already covered by node_modules/, but being explicit)
jspm_packages/

# Optional local development data
.local-data/
.local-storage/

# Optional custom environment overrides
.env.*

# Optional PWA icon generation outputs (if generated during build)
public/icons/generated/
public/icons/temp/

# Optional test output
test-results/
test-reports/

# Optional performance profiles
profile/
*.cpuprofile
*.heapsnapshot

# Optional debug files
debug/
*.pdb

# Optional TypeScript declaration maps
*.d.ts.map

# Optional source maps
*.js.map
*.css.map